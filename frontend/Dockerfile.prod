# Production image for the Next.js app (Sprint 17; docs/deployment.md).
FROM node:20-slim AS builder

WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
# The API URL is baked in at build time (NEXT_PUBLIC_*), so it's a build arg.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build


FROM node:20-slim AS runtime

RUN useradd --create-home --uid 10001 beautyai
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder --chown=beautyai:beautyai /app/.next ./.next
COPY --from=builder --chown=beautyai:beautyai /app/public ./public
COPY --from=builder --chown=beautyai:beautyai /app/node_modules ./node_modules
COPY --from=builder --chown=beautyai:beautyai /app/package.json ./package.json

USER beautyai
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD node -e "fetch('http://localhost:3000/').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["npm", "run", "start"]
