# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already in .gitignore.

# --- App ---
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- Postgres (used by docker-compose to init the container) ---
POSTGRES_USER=beautyai
POSTGRES_PASSWORD=beautyai
POSTGRES_DB=beautyai

# --- Database URLs (used by the backend app; docker-compose overrides
# these to point at the "postgres" service hostname instead of localhost) ---
DATABASE_URL=postgresql+asyncpg://beautyai:beautyai@localhost:5432/beautyai
DATABASE_URL_SYNC=postgresql+psycopg2://beautyai:beautyai@localhost:5432/beautyai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Auth ---
# Signs access tokens. The default is only accepted for APP_ENV=local/test;
# staging/production refuse to start without a random value of 32+ chars:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Booking ---
# How long a slot stays reserved for a patient on the payment step.
SLOT_HOLD_MINUTES=10
# Clinics' local time zone (booking requests like "tomorrow at 5 PM").
CLINIC_TIMEZONE=Africa/Cairo

# --- Uploads (doctor verification documents, see docs/verification.md) ---
# Where uploaded files are written (relative paths resolve from backend/).
# Keep this outside the repository in production, and back it up.
UPLOAD_DIR=var/uploads
MAX_UPLOAD_MB=10

# --- Rate limiting (see docs/security.md) ---
# Leave on everywhere except the test suite.
RATE_LIMIT_ENABLED=true

# --- Notifications (see docs/notifications.md) ---
# "demo" logs messages instead of sending them. Staging/production need "live".
NOTIFICATION_PROVIDER=demo
# Email, over any SMTP server.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=BeautyAI <no-reply@beautyai.example.com>
# SMS and WhatsApp, through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# When the reminder and the aftercare follow-up go out.
REMINDER_HOURS_BEFORE=24
AFTERCARE_HOURS_AFTER=24

# --- Payments (see docs/payments.md) ---
# "demo" = built-in fake checkout for local development. Staging/production
# must use "paymob" with the keys and at least one integration id.
PAYMENT_PROVIDER=demo
# How long a slot stays held while the patient pays online.
PAYMENT_WINDOW_MINUTES=15
# Public URLs: the webhook address given to the gateway, and where patients return.
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=

# --- AI chat (see docs/agents.md) ---
# "ollama" = a free local model through Ollama (no key, no tokens to run out).
# "demo" = offline rule-based stand-in (no AI at all).
# Staging/production must use "openai" with a key and an explicitly chosen model.
AI_PROVIDER=ollama
# Any model from `ollama list`. qwen2.5:3b replies in ~20 s on a 4 GB laptop GPU;
# qwen2.5:7b answers better but takes ~1 min there — use it on a stronger machine.
# Running the backend in Docker? Use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
OPENAI_API_KEY=
OPENAI_MODEL=
# Knowledge search embeddings (1536 dimensions), e.g. text-embedding-3-small.
OPENAI_EMBEDDING_MODEL=
# Local models are slow: give them time before the chat falls back.
AI_TIMEOUT_SECONDS=180
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MESSAGES_PER_HOUR=30
CHAT_HISTORY_MESSAGES=20

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
